# INFINITE-AI — environment variable NAMES ONLY.
#
# Rule 7 (Part 0 §0.2): no secret in the repository, ever — not in code, not in tests,
# not in fixtures, not in a comment, not in this file. Values are supplied by SOPS + age
# in development and AWS Secrets Manager in production.
#
# A test in packages/config asserts this file stays in step with EnvSchema and that
# every line here has an empty value. Adding a variable without listing it fails CI.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=
APP_REGION=
LOG_LEVEL=

# --- Data plane (Stage 01) ---------------------------------------------------
DATABASE_URL=
REDIS_URL=

# Base64-encoded 32-byte key for application-level encryption of learner identifiers.
# Generate with: openssl rand -base64 32
# Never commit a value here. SOPS + age in development, AWS Secrets Manager in production.
DB_ENCRYPTION_KEY=
DB_ENCRYPTION_KEY_VERSION=

# --- Identity (Stage 02) -----------------------------------------------------
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=

# --- Model gateway (Stage 04) ------------------------------------------------
# Application code calls the gateway. Provider credentials are configured on the
# gateway itself and never appear in any other service's environment.
GATEWAY_BASE_URL=

# --- Object storage ----------------------------------------------------------
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=

# --- Observability (Stage 15) ------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
