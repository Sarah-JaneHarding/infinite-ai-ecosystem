# apps/web's own environment — NAMES ONLY (rule 7). Mirrors the pattern in
# apps/gateway/.env.example. See src/lib/env.ts for how this file is validated; a test
# in tests/unit/env.spec.ts asserts this file stays in step with WebEnvSchema and that
# every line here has an empty value.

NODE_ENV=

# --- next-auth --------------------------------------------------------------
# The URL next-auth callbacks resolve against. Leave unset in local dev (next-auth
# infers it); set explicitly in any deployed environment.
NEXTAUTH_URL=
# Minimum 32 characters. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Keycloak OIDC provider ---------------------------------------------------
# AUTH_KEYCLOAK_ID matches infra/keycloak/realm.json's infinite-ai-web client id
# ("infinite-ai-web"). AUTH_KEYCLOAK_SECRET must match that same client's secret exactly —
# set via infra/docker/.env's KEYCLOAK_WEB_CLIENT_SECRET, substituted into the realm at
# import time. Never commit a value for either. See docs/DEV_SETUP.md.
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=
