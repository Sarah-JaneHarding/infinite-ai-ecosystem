{
  "name": "@infinite-ai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Next.js app — every role surface.",
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "@infinite-ai/brain": "workspace:*",
    "@infinite-ai/curriculum-seed": "workspace:*",
    "@infinite-ai/db": "workspace:*",
    "@infinite-ai/design-system": "workspace:*",
    "@infinite-ai/orchestrator": "workspace:*",
    "@infinite-ai/school-setup": "workspace:*",
    "@infinite-ai/learner-client": "workspace:*",
    "@infinite-ai/policy": "workspace:*",
    "@infinite-ai/security": "workspace:*",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
