{
  "name": "@infinite-ai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Next.js app — every role surface.",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
