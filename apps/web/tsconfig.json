{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
