{
  "name": "@infinite-ai/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BullMQ workers and the DAG runner host.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
