# The gateway's own environment — NAMES ONLY (rule 7). Provider credentials live here and
# nowhere else: no other service's environment ever carries a provider key. See
# packages/config/src/env.ts for everything else, and apps/gateway/src/config/env.ts for
# how this file is validated.
#
# A test in apps/gateway asserts this file stays in step with GatewayEnvSchema and that
# every line here has an empty value.

GATEWAY_PORT=

# --- Provider credentials -----------------------------------------------------
# Comma-separated for credential pooling (Stage 04 step 3). Never commit a value here.
# SOPS + age in development, AWS Secrets Manager in production.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEYS=

OPENAI_BASE_URL=
OPENAI_API_KEYS=

# Groq — ultra-fast LPU inference (https://console.groq.com)
GROQ_BASE_URL=
GROQ_API_KEYS=

# Google Gemini via OpenAI-compatible shim (https://ai.google.dev)
GEMINI_BASE_URL=
GEMINI_API_KEYS=

# Alibaba Qwen via DashScope (https://dashscope.aliyuncs.com) — multilingual
QWEN_BASE_URL=
QWEN_API_KEYS=

# LM Studio — local inference server (default http://localhost:1234/v1). Placeholder key ok.
LMSTUDIO_BASE_URL=
LMSTUDIO_API_KEYS=

# Ollama — local inference server (default http://localhost:11434/v1). Placeholder key ok.
OLLAMA_BASE_URL=
OLLAMA_API_KEYS=

# Microsoft Azure OpenAI / Copilot — per-deployment base URL (https://{resource}.openai.azure.com/openai/deployments/{deployment})
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEYS=

# Generic self-hosted OpenAI-compatible server (vLLM, TGI) — fallback for custom deployments.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEYS=

# --- Routing (Stage 04 step 4) -------------------------------------------------
# Path to a routing JSON file. Falls back to a minimal built-in default if unset.
ROUTING_CONFIG_PATH=
