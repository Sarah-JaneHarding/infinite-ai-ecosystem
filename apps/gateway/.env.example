# The gateway's own environment — NAMES ONLY (rule 7). Provider credentials live here and
# nowhere else: no other service's environment ever carries a provider key. See
# packages/config/src/env.ts for everything else, and apps/gateway/src/config/env.ts for
# how this file is validated.
#
# A test in apps/gateway asserts this file stays in step with GatewayEnvSchema and that
# every line here has an empty value.

GATEWAY_PORT=

# --- Anthropic Claude ----------------------------------------------------------
# Comma-separated for credential pooling (Stage 04 step 3). Never commit a value here.
# SOPS + age in development, AWS Secrets Manager in production.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEYS=

# --- OpenAI --------------------------------------------------------------------
OPENAI_BASE_URL=
OPENAI_API_KEYS=

# --- Google Gemini (native adapter: apps/gateway/src/adapters/google.ts) ------
GOOGLE_BASE_URL=
GOOGLE_API_KEYS=

# --- Groq (OpenAI-compatible adapter) ------------------------------------------
# URGENT: llama-3.3-70b-versatile was retired 16 Aug 2026.
# Default GROQ_MODEL_ID is openai/gpt-oss-120b — do not override with the old name.
GROQ_BASE_URL=
GROQ_API_KEYS=
GROQ_MODEL_ID=

# --- Qwen via Alibaba Cloud DashScope (OpenAI-compatible) ----------------------
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEYS=

# --- LM Studio (local OpenAI-compatible server on developer workstation) -------
LM_STUDIO_BASE_URL=
LM_STUDIO_API_KEYS=
LM_STUDIO_TIMEOUT_MS=

# --- Ollama (local) ------------------------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_API_KEYS=

# --- Ollama Cloud (hosted fallback) --------------------------------------------
OLLAMA_CLOUD_BASE_URL=
OLLAMA_CLOUD_API_KEYS=

# --- Genspark (agentic research tool — not a primary LLM) ----------------------
GENSPARK_BASE_URL=
GENSPARK_API_KEYS=
GENSPARK_TIMEOUT_MS=

# --- Azure OpenAI / Microsoft Copilot -----------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEYS=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Legacy generic self-hosted server (deprecated — use named slots above) ---
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEYS=

# --- Provider selection --------------------------------------------------------
# Which provider handles CAPS-aligned curriculum requests by default.
# One of: claude | gemini | groq | qwen | lm-studio | ollama | genspark | azure
AI_PROVIDER=

# --- Per-step model overrides (leave blank to use provider default) ------------
STEP1_MODEL_ID=
STEP2_MODEL_ID=
STEP3_MODEL_ID=
STEP4_MODEL_ID=
STEP5_MODEL_ID=

# --- Per-provider model defaults (leave blank to use the built-in default) -----
CLAUDE_MODEL_ID=
CLAUDE_PREMIUM_MODEL_ID=
GEMINI_MODEL_ID=
GEMINI_PREMIUM_MODEL_ID=

# --- Routing (Stage 04 step 4) -------------------------------------------------
# Path to a routing JSON file. Falls back to a minimal built-in default if unset.
ROUTING_CONFIG_PATH=
