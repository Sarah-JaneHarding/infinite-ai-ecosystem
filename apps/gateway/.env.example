# The gateway's own environment — NAMES ONLY (rule 7). Provider credentials live here and
# nowhere else: no other service's environment ever carries a provider key. See
# packages/config/src/env.ts for everything else, and apps/gateway/src/config/env.ts for
# how this file is validated.
#
# A test in apps/gateway asserts this file stays in step with GatewayEnvSchema and that
# every line here has an empty value.

GATEWAY_PORT=

# --- Provider credentials -----------------------------------------------------
# Comma-separated for credential pooling (Stage 04 step 3). Never commit a value here.
# SOPS + age in development, AWS Secrets Manager in production.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEYS=

OPENAI_BASE_URL=
OPENAI_API_KEYS=

# A self-hosted, OpenAI-compatible inference server (vLLM, Ollama, text-generation-inference).
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEYS=

# --- Routing (Stage 04 step 4) -------------------------------------------------
# Path to a routing JSON file. Falls back to a minimal built-in default if unset.
ROUTING_CONFIG_PATH=
