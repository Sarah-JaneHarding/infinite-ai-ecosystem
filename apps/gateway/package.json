{
  "name": "@infinite-ai/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model gateway service. The only egress point for model traffic.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:chaos": "vitest run test/chaos",
    "lint": "eslint src",
    "start": "tsx src/main.ts"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@infinite-ai/config": "0.1.0",
    "@infinite-ai/contracts": "0.1.0",
    "@infinite-ai/db": "0.1.0",
    "@infinite-ai/deident": "0.1.0",
    "@infinite-ai/guardrails": "0.1.0",
    "@infinite-ai/telemetry": "0.1.0",
    "zod": "4.6.7"
  }
}
