{
  "name": "@infinite-ai/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model gateway service. The only egress point for model traffic.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "start": "tsx src/main.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@infinite-ai/config": "workspace:*",
    "@infinite-ai/contracts": "workspace:*",
    "@infinite-ai/db": "workspace:*",
    "@infinite-ai/deident": "workspace:*",
    "@infinite-ai/guardrails": "workspace:*",
    "@infinite-ai/telemetry": "workspace:*",
    "zod": "3.25.76"
  }
}
