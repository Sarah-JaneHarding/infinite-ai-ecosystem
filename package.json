{
  "name": "infinite-ai",
  "version": "0.1.0",
  "private": true,
  "description": "INFINITE-AI Education Ecosystem — multi-tenant, POPIA-safe SaaS for South African schools.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=@infinite-ai/web",
    "build": "npm run build --workspace=@infinite-ai/web",
    "start": "npm run start --workspace=@infinite-ai/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@infinite-ai/analytics": "*",
    "@infinite-ai/brain": "*",
    "@infinite-ai/contracts": "*",
    "@infinite-ai/curriculum-seed": "*",
    "@infinite-ai/db": "*",
    "@infinite-ai/evals": "*",
    "@infinite-ai/warehouse": "*",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "electron-to-chromium": "1.5.420",
    "nanoid": "3.3.18",
    "deepmerge-ts": "8.0.2"
  }
}
