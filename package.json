{
  "name": "infinite-ai",
  "version": "0.1.0",
  "private": true,
  "description": "INFINITE-AI Education Ecosystem \u2014 multi-tenant, POPIA-safe SaaS for South African schools.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check:retention": "tsx scripts/check-retention-schedule.ts",
    "evals:run": "tsx scripts/evals-run.ts",
    "evals:gate": "tsx scripts/evals-gate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:injection": "pnpm --filter @infinite-ai/guardrails test:injection",
    "test:redteam:diagnosis": "pnpm --filter @infinite-ai/guardrails exec vitest run test/diagnosis-redteam.spec.ts",
    "test:drill:safeguarding": "pnpm --filter @infinite-ai/analytics exec vitest run test/safeguarding-drill.spec.ts",
    "test:bias-monitor": "pnpm --filter @infinite-ai/analytics exec vitest run test/bias-monitor.spec.ts",
    "test:readability": "pnpm --filter @infinite-ai/contracts exec vitest run test/toolbox-readability-bands.spec.ts",
    "test:answer-key-verification": "pnpm --filter @infinite-ai/contracts exec vitest run test/toolbox-answer-key-verification.spec.ts",
    "test:accessibility": "pnpm --filter @infinite-ai/contracts exec vitest run test/toolbox-accessibility-validator.spec.ts",
    "typecheck": "turbo run typecheck",
    "verify:stage": "tsx scripts/verify-stage.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@infinite-ai/contracts": "workspace:*",
    "@infinite-ai/evals": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
