# infra/docker/compose.dev.yml — NAMES ONLY (rule 7). Copy to infra/docker/.env and fill
# in locally; never commit a filled-in copy. These are separate from the root .env
# (packages/config's EnvSchema) — the app's own runtime config never carries a database
# superuser or role password, only the connection string it needs (see the root
# .env.example's own DATABASE_URL, and the note on DATABASE_URL below).
#
# Usage: docker compose --env-file infra/docker/.env -f infra/docker/compose.dev.yml up -d
# (or `cd infra/docker && docker compose up -d` once this file is named `.env` there).

# --- Postgres superuser + database name --------------------------------------
# What the pgvector/pgvector:pg16 image itself boots with. Pick any values; they are
# local-dev-only and never used by the application roles below. Suggested for local dev:
# POSTGRES_DB=infinite_ai_dev, POSTGRES_USER=postgres.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- The four database roles (infra/docker/initdb/02-roles.sh) ---------------
# migrator      owns the schema; the only role that may run `prisma migrate`.
# app_rw        the web application's role — DML only, RLS enforced.
# worker_rw     the BullMQ workers' role — DML only, RLS enforced.
# analytics_ro  read-only, de-identified views only.
#
# Generate each with: openssl rand -base64 24
MIGRATOR_PASSWORD=
APP_RW_PASSWORD=
WORKER_RW_PASSWORD=
ANALYTICS_RO_PASSWORD=

# --- Keycloak (Stage 02 identity provider) ------------------------------------
# Suggested for local dev: KEYCLOAK_ADMIN=admin.
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Substituted into infra/keycloak/realm.json's infinite-ai-web / infinite-ai-worker
# client secrets at import time. Pick any values; they become those clients' secrets in
# the imported realm. KEYCLOAK_WEB_CLIENT_SECRET must match apps/web/.env's own
# AUTH_KEYCLOAK_SECRET exactly — same secret, two files, because the web app authenticates
# against Keycloak as this client.
KEYCLOAK_WEB_CLIENT_SECRET=
KEYCLOAK_WORKER_CLIENT_SECRET=

# Substituted into infra/keycloak/realm.json's nine dev-login users (one per Role, all in
# the Kleinbos Primary dev tenant) — see docs/DEV_SETUP.md's "Signing in as each role"
# section. `temporary: true` on each forces a password reset on first login, so this value
# is never the account's real, lasting password. Generate with: openssl rand -base64 24.
SEED_USER_PASSWORD=

# --- MinIO (S3-compatible object storage for local dev) -----------------------
# Suggested for local dev: MINIO_ROOT_USER=minioadmin.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# The bucket the one-shot minio-init service creates on boot. Must match the root
# .env's own OBJECT_STORE_BUCKET exactly — same name, two files, same "one value used by
# two different processes at two different times" shape KEYCLOAK_WEB_CLIENT_SECRET
# already has above: this file provisions the bucket, the app's own .env points at it.
OBJECT_STORE_BUCKET=

# --- Langfuse (self-hosted LLM observability backend) -------------------------
# Its own Postgres, Redis and ClickHouse — never the app's own above — so its
# migrations and internal queues can never collide with ours. Only MinIO (above) is
# shared: minio-init also creates a fixed "langfuse" bucket there, no variable needed
# for the bucket name since S3 buckets are namespaced and it is never secret.
#
# Suggested for local dev: LANGFUSE_POSTGRES_USER=langfuse, LANGFUSE_CLICKHOUSE_USER=clickhouse.
LANGFUSE_POSTGRES_USER=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_CLICKHOUSE_USER=
LANGFUSE_CLICKHOUSE_PASSWORD=

# SALT hashes stored API keys; ENCRYPTION_KEY encrypts stored provider credentials.
# openssl rand -base64 24 (SALT); openssl rand -hex 32 (ENCRYPTION_KEY — must be exactly
# 64 hex characters, Langfuse's own requirement).
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=

# Bootstraps a real org/project/user/API-key pair on first boot (Langfuse's own
# LANGFUSE_INIT_* variables) — no manual "sign up in the UI" step for local dev. Pick any
# values; Langfuse does not validate the public/secret key format at init time, only at
# query time. LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY are what the root .env's
# OTEL_EXPORTER_OTLP_HEADERS is built from — see docs/DEV_SETUP.md.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

# =============================================================================
# compose.apps.yml — the gateway, worker and web containers
# =============================================================================
# Run AFTER the data plane (docs/DEV_SETUP.md, "The whole stack in Docker"). Names only
# (rule 7). These values are read INSIDE containers, so URLs use compose service names
# (`postgres`, `redis`, `minio`), never `localhost`.
#
# A variable that is present but EMPTY is an error, not "unset": the apps validate their
# environment strictly and exit at boot (e.g. a blank OTEL_EXPORTER_OTLP_ENDPOINT -> "Invalid
# url"). Everything below is required and must be filled in; optional variables are
# commented out — leave them commented, or delete them, if you do not use them.

# The application's least-privilege role (app_rw), never the migrator. DIRECT_DATABASE_URL is
# the unpooled URL some tooling expects; with no pooler in front it is the same value.
#   postgresql://app_rw:<APP_RW_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=
DIRECT_DATABASE_URL=
#   redis://redis:6379
REDIS_URL=

# One URL that BOTH the web container and your browser can open, because the browser is
# redirected to it and the same string is the token issuer:
#   http://host.docker.internal:8180/realms/infinite-ai
# (Linux engine: also add `127.0.0.1 host.docker.internal` to /etc/hosts.)
KEYCLOAK_ISSUER=

#   http://minio:9000   — and the MinIO root credentials set above.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

#   http://localhost:3000
NEXTAUTH_URL=
# openssl rand -base64 32
NEXTAUTH_SECRET=
#   infinite-ai-web, and the same value as KEYCLOAK_WEB_CLIENT_SECRET above.
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=

# openssl rand -base64 32. Set it BEFORE seeding and keep it: without it the gateway's PII
# guard refuses every request, and a seed run without it encrypts the dev learners under a
# throwaway key the gateway can never use.
DB_ENCRYPTION_KEY=

# Provider credentials — gateway only; no other service receives them. The gateway refuses
# to boot unless every provider named in its routing file has a credential, and the shipped
# apps/gateway/routing.json names four: anthropic, openai, google and local (an
# OpenAI-compatible server such as Ollama). Fill in all four (a placeholder is fine for a
# provider you will not call), or point ROUTING_CONFIG_PATH at a routing file that lists only
# the providers you have and fill in just those. Uncomment what you use.
# ANTHROPIC_API_KEYS=
# OPENAI_API_KEYS=
# GOOGLE_API_KEYS=
# LOCAL_MODEL_BASE_URL=
# LOCAL_MODEL_API_KEYS=

# Optional tracing (Langfuse) — uncomment BOTH only if you run it; never leave them blank.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# Optional: DB_ENCRYPTION_KEY_VERSION (default 1), IMAGE_TAG (default latest).

# --- Note on DATABASE_URL (root .env, not this file) --------------------------
# The same DATABASE_URL env var is used for two different jobs at different times, with
# two different roles — there is no single correct value:
#   1. Running a migration (`pnpm --filter @infinite-ai/db db:migrate:dev/:deploy`):
#      point it at the `migrator` role — the only one with schema-DDL privileges.
#        postgresql://migrator:<MIGRATOR_PASSWORD>@localhost:5432/<POSTGRES_DB>
#   2. Running an app (`apps/web`, `apps/gateway`, `apps/worker`) or seeding data:
#      point it at `app_rw` — least-privilege, RLS-enforced, what rule 5 requires.
#        postgresql://app_rw:<APP_RW_PASSWORD>@localhost:5432/<POSTGRES_DB>
# See docs/DEV_SETUP.md for the full sequence.
