{
  "name": "@infinite-ai/telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenTelemetry setup, the append-only audit ledger client, and the one sanctioned structured logger.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:trace-coverage": "vitest run test/trace-coverage.spec.ts",
    "test:log-scrub": "vitest run test/log-scrub.spec.ts",
    "lint": "eslint src"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  }
}
