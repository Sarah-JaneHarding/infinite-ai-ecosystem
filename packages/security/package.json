{
  "name": "@infinite-ai/security",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Security primitives: HTTP headers, CSP, CSRF, per-tenant rate limiting, quota enforcement, and agent tool allow-lists.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
