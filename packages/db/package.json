{
  "name": "@infinite-ai/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations, the tenant-scoped client and the RLS suite.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "coverage:merged": "pnpm test:coverage && pnpm test:integration:coverage && vitest --merge-reports --config vitest.merge.config.ts --coverage",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "lint": "eslint src",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=blob --outputFile=.vitest-reports/unit.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage --reporter=blob --outputFile=.vitest-reports/integration.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@infinite-ai/contracts": "workspace:*",
    "@testcontainers/postgresql": "12.0.4",
    "@vitest/coverage-v8": "3.2.7",
    "prisma": "6.19.3",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
