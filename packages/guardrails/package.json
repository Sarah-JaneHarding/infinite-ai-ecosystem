{
  "name": "@infinite-ai/guardrails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Input/output validators, refusal policy, PII egress guard.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "test:coverage": "vitest run --coverage",
    "test:injection": "vitest run test/prompt-injection.spec.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@testcontainers/postgresql": "12.0.4",
    "@vitest/coverage-v8": "3.2.7",
    "testcontainers": "12.0.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@infinite-ai/brain": "*",
    "@infinite-ai/contracts": "*",
    "@infinite-ai/db": "*",
    "@infinite-ai/deident": "*",
    "@infinite-ai/policy": "*",
    "@infinite-ai/telemetry": "*",
    "zod": "3.25.76"
  }
}
