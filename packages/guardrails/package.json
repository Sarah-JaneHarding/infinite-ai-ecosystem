{
  "name": "@infinite-ai/guardrails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Input/output validators, refusal policy, PII egress guard.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "test:coverage": "vitest run --coverage",
    "test:injection": "vitest run test/prompt-injection.spec.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@testcontainers/postgresql": "12.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@infinite-ai/brain": "workspace:*",
    "@infinite-ai/contracts": "workspace:*",
    "@infinite-ai/db": "workspace:*",
    "@infinite-ai/deident": "workspace:*",
    "@infinite-ai/policy": "workspace:*",
    "@infinite-ai/telemetry": "workspace:*",
    "zod": "4.6.7"
  }
}
