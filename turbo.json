{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Packages are consumed from source across the workspace, so nothing is emitted
      // yet. Add "dist/**" and ".next/**" here when a package starts emitting.
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      // Add "coverage/**" when coverage reporting is wired in Stage 01.
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
